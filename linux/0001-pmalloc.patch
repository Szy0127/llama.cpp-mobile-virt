diff --git a/include/linux/gfp.h b/include/linux/gfp.h
index 7f9691d37..6a5889482 100644
--- a/include/linux/gfp.h
+++ b/include/linux/gfp.h
@@ -216,6 +216,59 @@ unsigned long alloc_pages_bulk_noprof(gfp_t gfp, int preferred_nid,
 				struct page **page_array);
 #define __alloc_pages_bulk(...)			alloc_hooks(alloc_pages_bulk_noprof(__VA_ARGS__))
 
+/* pmalloc interface - allocate pages getting biggest orders first with order info */
+struct pmalloc_page_info {
+	struct page *page;
+	unsigned int order;
+	unsigned long size_bytes;
+	void *virt_addr;
+	unsigned long phys_addr;
+	struct list_head list;
+};
+
+unsigned long pmalloc_get_pages_with_info(gfp_t gfp, int preferred_nid,
+				   nodemask_t *nodemask, 
+				   struct list_head *page_info_list,
+				   unsigned long target_size,
+				   unsigned long max_pages);
+unsigned long pmalloc_get_size_with_info(unsigned long size_mb, 
+					  struct list_head *page_info_list);
+unsigned long pmalloc_get_dma_pages(unsigned long size_mb, 
+				     struct list_head *page_info_list);
+void pmalloc_free_pages_with_info(struct list_head *page_info_list);
+int pmalloc_get_available_info_count(void);
+
+/* Helper functions to access pmalloc_page_info */
+static inline unsigned int pmalloc_page_order(struct pmalloc_page_info *info)
+{
+	return info ? info->order : 0;
+}
+
+static inline unsigned long pmalloc_page_size(struct pmalloc_page_info *info)
+{
+	return info ? info->size_bytes : 0;
+}
+
+static inline void *pmalloc_page_address(struct pmalloc_page_info *info)
+{
+	return info ? info->virt_addr : NULL;
+}
+
+static inline unsigned long pmalloc_page_phys_addr(struct pmalloc_page_info *info)
+{
+	return info ? info->phys_addr : 0;
+}
+
+/* pmalloc interface - allocate pages getting biggest orders first */
+unsigned long pmalloc_get_pages(gfp_t gfp, int preferred_nid,
+			       nodemask_t *nodemask, 
+			       struct list_head *page_list,
+			       unsigned long target_size,
+			       unsigned long max_pages);
+unsigned long pmalloc_get_size(unsigned long size_mb, struct list_head *page_list);
+unsigned long pmalloc_get_all_free(gfp_t gfp, struct list_head *page_list);
+void pmalloc_example_22mb(void);  /* Example: 22MB allocation */
+
 unsigned long alloc_pages_bulk_array_mempolicy_noprof(gfp_t gfp,
 				unsigned long nr_pages,
 				struct page **page_array);
diff --git a/kmod/Makefile b/kmod/Makefile
